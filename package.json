{
  "name": "honey-mustard-lebanon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/prerender.tsx --outDir .ssr && node .ssr/prerender.js",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format:check": "prettier --check src tests scripts vite.config.ts index.html tsconfig.json package.json",
    "qa": "node scripts/qa-server.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "axe-core": "4.10.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  },
  "packageManager": "pnpm@11.19.0"
}
